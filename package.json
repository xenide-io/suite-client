{
  "name": "@xenide-io/suite-client",
  "version": "0.1.0",
  "description": "Framework-agnostic platform layer shared across Xenide ShellStack apps — API client, auth, workspace, cross-app sync, notifications, errors.",
  "author": "Xenide",
  "license": "MIT",
  "homepage": "https://github.com/xenide-io/suite-client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xenide-io/suite-client.git"
  },
  "keywords": [
    "xenide",
    "shellstack",
    "suite",
    "api-client",
    "typescript"
  ],
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=20.9.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --sourcemap --clean --external react --external react-dom --tsconfig ./tsconfig.lib.json",
    "build:lib": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "package:smoke": "node scripts/package-smoke.mjs",
    "prepublishOnly": "bun run build && bun run package:smoke",
    "release": "bun run typecheck && bun run lint && bun run test && bun run build && bun run package:smoke && npm publish"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.0.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
